[Unit]
Description=bpfrag - eBPF network tuning for competitive gaming
After=network.target
# Coexists with bpftune and sched_ext schedulers (scx.service); no ordering needed.

[Service]
Type=simple
EnvironmentFile=-/etc/default/bpfrag
ExecStart=/usr/bin/bpfrag $BPFRAG_FLAGS
# Whatever happens to the daemon, put the system back.
ExecStopPost=/usr/bin/bpfrag --restore
Restart=on-failure
RestartSec=2

# BPF and perf (loading and attaching the programs), net admin (tc, ethtool,
# nl80211), resource (memlock on old kernels), and reading other users'
# /proc/<pid>/environ and Steam libraries for the classifier. No
# CAP_SYS_ADMIN. /proc/sys and /run/bpfrag must stay writable.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
# Things bpfrag never does: switch personality or architecture, set the
# clock or hostname, use real-time scheduling (it leaves the CPU alone),
# make setuid files or new namespaces.
LockPersonality=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
RuntimeDirectory=bpfrag
RuntimeDirectoryPreserve=yes
# Today's [experiment] pick, kept across reboots.
StateDirectory=bpfrag

[Install]
WantedBy=multi-user.target
