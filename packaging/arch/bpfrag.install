post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now bpfrag.service >/dev/null 2>&1 || true
}

post_upgrade() {
  # Respects a disabled service: only restarts it if it's running.
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl try-restart bpfrag.service >/dev/null 2>&1 || true
}

pre_remove() {
  # Stop while /usr/bin/bpfrag still exists, so ExecStopPost can put any
  # match-time settings back before the binary is gone.
  systemctl disable --now bpfrag.service >/dev/null 2>&1 || true
}
