post_install() {
  cat <<MSG
==> bpfrag installed. Check what works on this machine, then enable it:
      sudo bpfrag --check && sudo bpfrag --selftest
      sudo systemctl enable --now bpfrag
    Flags: /etc/default/bpfrag   Tiers and lists: /etc/bpfrag/bpfrag.toml
MSG
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl is-active --quiet bpfrag.service 2>/dev/null; then
    echo "==> restarting bpfrag"
    systemctl try-restart bpfrag.service
  fi
}

pre_remove() {
  # Stop while /usr/bin/bpfrag still exists, so ExecStopPost can put any
  # match-time settings back before the binary is gone.
  systemctl disable --now bpfrag.service >/dev/null 2>&1 || true
}
